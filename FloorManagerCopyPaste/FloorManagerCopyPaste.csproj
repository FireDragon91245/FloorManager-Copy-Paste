<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>FloorManagerCopyPaste</AssemblyName>
    <RootNamespace>FloorManagerCopyPaste</RootNamespace>
    <RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))</RepoRoot>
    <MelonLoaderRefDir Condition="'$(MelonLoaderRefDir)' == ''">$(RepoRoot)MelonLoader_x64\MelonLoader\net6</MelonLoaderRefDir>
    <Il2CppAssembliesDir Condition="'$(Il2CppAssembliesDir)' == '' and '$(GameDir)' != ''">$(GameDir)\MelonLoader\Il2CppAssemblies</Il2CppAssembliesDir>
    <CopyModToGame Condition="'$(CopyModToGame)' == ''">true</CopyModToGame>
    <CopyModToGameNormalized>$([System.String]::Copy('$(CopyModToGame)').ToLowerInvariant())</CopyModToGameNormalized>
  </PropertyGroup>

  <Target Name="ValidateDevPaths" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(MelonLoaderRefDir)\MelonLoader.dll')"
           Text="MelonLoader refs not found. Set MelonLoaderRefDir in Directory.Build.props.user or keep the extracted MelonLoader files in $(RepoRoot)MelonLoader_x64\MelonLoader\net6." />
    <Error Condition="'$(Il2CppAssembliesDir)' == '' or !Exists('$(Il2CppAssembliesDir)\Assembly-CSharp.dll')"
           Text="Il2Cpp assemblies not found. Launch the game once with MelonLoader installed, then set GameDir or Il2CppAssembliesDir in Directory.Build.props.user." />
  </Target>

  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(MelonLoaderRefDir)\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(MelonLoaderRefDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Common">
      <HintPath>$(MelonLoaderRefDir)\Il2CppInterop.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.Runtime">
      <HintPath>$(MelonLoaderRefDir)\Il2CppInterop.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppInterop.HarmonySupport">
      <HintPath>$(MelonLoaderRefDir)\Il2CppInterop.HarmonySupport.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(Il2CppAssembliesDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2Cppmscorlib">
      <HintPath>$(Il2CppAssembliesDir)\Il2Cppmscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Il2CppSystem.Core">
      <HintPath>$(Il2CppAssembliesDir)\Il2CppSystem.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(Il2CppAssembliesDir)\Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(Il2CppAssembliesDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(Il2CppAssembliesDir)\UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(Il2CppAssembliesDir)\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(Il2CppAssembliesDir)\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(Il2CppAssembliesDir)\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>$(Il2CppAssembliesDir)\Unity.InputSystem.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.Entities">
      <HintPath>$(Il2CppAssembliesDir)\Unity.Entities.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyBuiltModToGame" AfterTargets="Build" Condition="'$(CopyModToGameNormalized)' == 'true' and '$(GameDir)' != ''">
    <MakeDir Directories="$(GameDir)\Mods" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll" DestinationFolder="$(GameDir)\Mods" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pdb" DestinationFolder="$(GameDir)\Mods" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
  </Target>

</Project>
